{
  "name": "dsh-tool-mud",
  "version": "0.3.2",
  "description": "DSH plugin built for 北大侠客行 (pkuxkx): one persistent telnet session as a `mud` tool, plus a right-sidebar panel for logs, AI actions, plan/diary, and a human-only fullme handoff.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "cordis.patch.example.yml"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "mud",
    "telnet",
    "pkuxkx",
    "北大侠客行",
    "deepseek-harness"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shirakawa-Kotone/dsh-tool-mud.git"
  },
  "homepage": "https://github.com/Shirakawa-Kotone/dsh-tool-mud#readme",
  "bugs": {
    "url": "https://github.com/Shirakawa-Kotone/dsh-tool-mud/issues"
  }
